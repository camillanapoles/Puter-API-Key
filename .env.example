PORT=3000
PUTER_API_ORIGIN=https://api.puter.com
SESSION_TTL_HOURS=24

# Optional server token mode (enables no-sign-in key management + usage)
# PUTER_AUTH_TOKEN=replace_with_your_puter_auth_token
#
# Optional static key allowlist (old behavior)
# APP_API_KEYS=sk_static_fallback_key

# Comma-separated additional Puter auth tokens for API fallback
# When one account fails, the request automatically retries on the next account
# PUTER_FALLBACK_TOKENS=token1,token2,token3

# Seconds to deprioritize a failed account before retrying it (default: 60)
# FALLBACK_COOLDOWN_SECONDS=60

# --- Model aliases (stable ids for clients) ---
DEFAULT_CHAT_MODEL=fugu
# Fallback chain when Puter rejects a model as invalid_model
MODEL_ALIAS_FALLBACKS=claude-sonnet-4-5,gpt-5-nano
# Pin real Puter model ids per alias (leave empty to auto-discover)
# FUGU_MODEL_CANDIDATES=fugu-1,claude-fugu-1.5
# CLAUDE_56_MODEL_CANDIDATES=claude-sonnet-5-6
# Model list cache lifetime (seconds)
MODEL_LIST_CACHE_SECONDS=600
# Bind address (0.0.0.0 is required for the Arena preview proxy)
HOST=0.0.0.0
