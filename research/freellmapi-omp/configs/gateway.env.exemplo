# Trecho de .env do FreeLLMAPI otimizado para servir um coding agent (omp).
# Faça merge no ~/freellmapi/.env (installer) ou no .env do seu docker-compose.
# Só as linhas não comentadas mudam o padrão — o resto é referência.

PORT=3001
ENCRYPTION_KEY=              # obrigatório em produção (64 hex chars)

# ── 1. Rate limit do proxy ────────────────────────────────────────────────────
# Padrão 120 req/min por IP. Um agente com subagents paralelos + turnos longos
# passa disso e você vê 429 vindo do GATEWAY (não do provider).
PROXY_RATE_LIMIT_RPM=600

# ── 2. Orçamento de tempo e timeouts ─────────────────────────────────────────
# Base do failover: 45s é apertado para turnos de agente; o adaptativo (P95 de
# TTFB) amplia, mas subir a base reduz "attempts exhausted" em picos.
FALLBACK_TIME_BUDGET_MS=90000
SLOW_ENDPOINT_BUFFER_MS=15000
# Watchdog de stream parado (padrão 90s). Free tiers enfileiram; 180s evita
# corte no meio de uma resposta longa.
PROVIDER_STREAM_STALL_TIMEOUT_MS=180000
# Timeout por plataforma, quando alguma for sistematicamente lenta (exemplo):
# PROVIDER_TIMEOUT_NVIDIA=300000

# ── 3. Compressão de prompt (economia de cota) ───────────────────────────────
# off -> lossless (seguro) -> standard (filtra saída de git/test/build) -> aggressive.
# Comece em lossless; vá para standard e observe qualidade/estatística no dashboard.
FREELLMAPI_COMPRESSION=lossless

# ── 4. Cache de resposta (opcional) ──────────────────────────────────────────
# Match EXATO do request inteiro. Ajuda em replay/retry, é irrelevante em turnos
# que carregam resultado de ferramenta novo. PERSIST grava resposta em texto no SQLite.
# RESPONSE_CACHE=true
# RESPONSE_CACHE_PERSIST=false
# RESPONSE_CACHE_TTL_SECONDS=3600
# RESPONSE_CACHE_MAX_TEMPERATURE=0.2

# ── 5. Observabilidade ───────────────────────────────────────────────────────
# X-Fallback-Trail já vem sempre; isto acrescenta tempos por hop e erro do provider.
FALLBACK_DETAIL_HEADER=1
# Guarda IP+UA nas analytics ("Recent calls" no dashboard).
REQUEST_ANALYTICS_LOG_CLIENT=true

# ── 6. Segurança de exposição ────────────────────────────────────────────────
# Docker: publique só em loopback (padrão). Abra para LAN apenas em rede confiável.
HOST_BIND=127.0.0.1
# Se o dashboard puder ser alcançado por terceiros:
# FREEAPI_BLOCK_PRIVATE_PROVIDER_URLS=true

# ── 7. Body / imagens (sessões com screenshots) ──────────────────────────────
# REQUEST_BODY_LIMIT_MB=25
# IMAGE_NORMALIZE=on
# IMAGE_NORMALIZE_MAX_DIMENSION=2048
